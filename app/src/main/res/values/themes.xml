<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="bar_bg">#FF222222</color> <!-- = BarBg в Color.kt -->

    <!-- System force-dark opt-out: AOSP and Android 16 expanded dark theme check the dark parent (isLightTheme), OEM ROMs check forceDarkAllowed -->
    <style name="Theme.ImagoEdit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bar_bg</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/bar_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
    </style>
</resources>
